+def test_undefined_call_includes_name() -> None:
+    """Calling an undefined variable should mention its name in the error."""
+    env = Environment(undefined=jinja2.Undefined)
+    tmpl = env.from_string("{{ missing() }}")
+
+    with pytest.raises(UndefinedError) as exc_info:
+        tmpl.render()
+
+    msg = str(exc_info.value)
+    assert "missing" in msg, (
+        f"UndefinedError message should include variable name 'missing', got: {msg!r}"
+    )
