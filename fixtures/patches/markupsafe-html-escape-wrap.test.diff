+def test_escape_html_method_result_is_markup() -> None:
+    """escape() must return Markup even when __html__ returns a plain str."""
+
+    class HasHtml:
+        def __html__(self) -> str:
+            return "<b>safe</b>"
+
+    result = escape(HasHtml())
+    assert isinstance(result, Markup), (
+        f"escape() should return Markup, got {type(result).__name__!r}"
+    )
